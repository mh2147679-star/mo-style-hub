# ─── Database (Neon / Supabase / Railway) ────────────────────────────────────
# Get these from your cloud PostgreSQL provider dashboard.
# DATABASE_URL is the pooled connection; DIRECT_URL is for migrations.
DATABASE_URL="postgresql://user:password@host:5432/mo_style_hub?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/mo_style_hub?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-key-here"
# Full URL of your app — must match your actual deployment URL in production
NEXTAUTH_URL="http://localhost:3000"

# ─── App ──────────────────────────────────────────────────────────────────────
# Used for Stripe success/cancel redirect URLs — must match your deployment URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Get from Stripe Dashboard → Webhooks after registering your endpoint,
# or from `stripe listen` output during local development
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Resend (transactional email) ────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_..."
# Must be a verified sender address in your Resend account
EMAIL_FROM="Mo Style Hub <orders@yourdomain.com>"

# ─── Cloudinary (product image uploads) ─────────────────────────────────────
# Get your cloud name from https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
# Create an unsigned upload preset in Cloudinary → Settings → Upload → Upload presets
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="mo-style-hub"

# ─── Optional: Google OAuth ──────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
